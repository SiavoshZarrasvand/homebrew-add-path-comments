#!/usr/bin/env ruby
# add-path-comments/add-path-comments
# add-path-comments — add file path comments to TypeScript/TSX, Rust, and Python projects

VERSION = "1.0.5"

require 'yaml'

# ── Global excludes (apply to all project types) ─────────────────────────────
GLOBAL_EXCLUDE_DIRS = [
  "prisma",
  "public",
  "node_modules",
  "target",
  "dist",
  "build"
]

GLOBAL_EXCLUDE_PATH_SEGMENTS = [
  "/components/ui/"
]

# ── Config per project type ──────────────────────────────────────────────────
CONFIGS = {
  "ts" => {
    "extensions" => ["*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs"],
    "comment" => "//",
    "exclude_files" => [
      "next-env.d.ts", "tsconfig.json", "tsconfig.tsbuildinfo",
      "tailwind.config.ts", "vitest.config.ts", "postcss.config.mjs",
      "eslint.config.mjs", "components.json", "next.config.ts",
      "tailwind.config.js", "postcss.config.js", "next.config.js",
      "eslint.config.js", "eslint.config.cjs", "webpack.config.js"
    ]
  },
  "rust" => {
    "extensions" => ["*.rs"],
    "comment" => "//",
    "exclude_files" => []
  },
  "python" => {
    "extensions" => ["*.py"],
    "comment" => "#",
    "exclude_files" => ["__init__.py"]
  },
  "ruby" => {
    "extensions" => ["*.rb", "add-path-comments"],
    "comment" => "#",
    "exclude_files" => []
  },
  "shell" => {
    "extensions" => ["*.sh", "release.sh", "purgeapp"],
    "comment" => "#",
    "exclude_files" => []
  }
}

MARKERS = {
  "ts" => ["package.json"],
  "rust" => ["Cargo.toml"],
  "python" => ["pyproject.toml", "uv.lock"],
  "ruby" => ["Gemfile", "Rakefile", "Formula"],
  "shell" => ["release.sh"]
}

# ── Command line flags ────────────────────────────────────────────────────────
DRY_RUN = ARGV.include?("-d") || ARGV.include?("--dry-run")
CHECK = ARGV.include?("-c") || ARGV.include?("--check")
REMOVE = ARGV.include?("-r") || ARGV.include?("--remove")
STDOUT_MODE = ARGV.include?("-s") || ARGV.include?("--stdout")
HELP = ARGV.include?("-h") || ARGV.include?("--help")
VERSION_FLAG = ARGV.include?("-v") || ARGV.include?("--version")

READ_ONLY = DRY_RUN || CHECK || STDOUT_MODE

def usage
  puts ""
  puts "add-path-comments v#{VERSION} — add file path comments to projects"
  puts ""
  puts "Usage:"
  puts "  add-path-comments [options] [path]"
  puts ""
  puts "Options:"
  puts "  -r, --remove     Strip path comments instead of adding them"
  puts "  -s, --stdout     Print annotated copies to stdout, leaving files untouched"
  puts "  -d, --dry-run    Show what would change without modifying files"
  puts "  -c, --check      Like --dry-run, but exits 1 if anything needs fixing"
  puts "  -v, --version    Print version"
  puts "  -h, --help       Show this help message"
  puts ""
end

def report(message)
  STDOUT_MODE ? warn(message) : puts(message)
end

if HELP
  usage
  exit 0
elsif VERSION_FLAG
  puts "add-path-comments v#{VERSION}"
  exit 0
end

def find_repo_root(start_dir)
  curr = File.expand_path(start_dir)
  loop do
    return curr if File.exist?(File.join(curr, ".git"))
    parent = File.dirname(curr)
    break if parent == curr
    curr = parent
  end
  start_dir
end

# Filter out options to find target path
args = ARGV.reject { |arg| arg.start_with?("-") }
target_path = args.empty? ? Dir.pwd : args[0]
target_dir = File.expand_path(target_path)

single_file = File.file?(target_dir)

if !single_file && !Dir.exist?(target_dir)
  warn "Error: No such file or directory: #{target_path}"
  exit 1
end

if single_file && !STDOUT_MODE
  warn "Error: a single file target is only supported with --stdout"
  exit 1
end

repo_root = find_repo_root(single_file ? File.dirname(target_dir) : target_dir)

# ── Load local configuration (.pcrc) ──────────────────────────────────────────
local_config = {}
[".pcrc", ".pcrc.yaml", ".pcrc.yml"].each do |filename|
  config_file = File.join(repo_root, filename)
  if File.exist?(config_file)
    begin
      local_config = YAML.safe_load(File.read(config_file)) || {}
      break
    rescue => e
      puts "Warning: Failed to parse configuration file #{filename}: #{e.message}"
    end
  end
end

custom_exclude_dirs = [local_config["exclude_dirs"]].flatten.compact
custom_exclude_files = [local_config["exclude_files"]].flatten.compact
custom_exclude_path_segments = [local_config["exclude_path_segments"]].flatten.compact
custom_projects = [local_config["projects"]].flatten.compact

# Merge exclusions
GLOBAL_EXCLUDE_DIRS.concat(custom_exclude_dirs).uniq!
GLOBAL_EXCLUDE_PATH_SEGMENTS.concat(custom_exclude_path_segments).uniq!

# ── Project discovery ─────────────────────────────────────────────────────────
def find_projects(root, custom_projects)
  projects = []

  # Add custom projects explicitly declared in .pcrc
  custom_projects.each do |proj_rel_path|
    proj_abs_path = File.expand_path(File.join(root, proj_rel_path))
    if Dir.exist?(proj_abs_path)
      MARKERS.each do |ptype, markers|
        if markers.any? { |m| File.exist?(File.join(proj_abs_path, m)) }
          unless projects.any? { |p_root, p_t| p_root == proj_abs_path && p_t == ptype }
            projects << [proj_abs_path, ptype]
          end
        end
      end
    end
  end

  # Helper for recursive search up to depth 3
  search_dir = lambda do |dir, depth|
    return if depth > 3

    name = File.basename(dir)
    return if name.start_with?(".")
    return if GLOBAL_EXCLUDE_DIRS.include?(name)

    MARKERS.each do |ptype, markers|
      if markers.any? { |m| File.exist?(File.join(dir, m)) }
        unless projects.any? { |p_root, p_t| p_root == dir && p_t == ptype }
          projects << [dir, ptype]
        end
      end
    end

    Dir.glob(File.join(dir, "*")).sort.each do |subdir|
      if File.directory?(subdir)
        search_dir.call(subdir, depth + 1)
      end
    end
  end

  # Check root itself
  MARKERS.each do |ptype, markers|
    if markers.any? { |m| File.exist?(File.join(root, m)) }
      unless projects.any? { |p_root, p_t| p_root == root && p_t == ptype }
        projects << [root, ptype]
      end
    end
  end

  # Scan subdirectories recursively (starting depth 2)
  Dir.glob(File.join(root, "*")).sort.each do |subdir|
    if File.directory?(subdir)
      search_dir.call(subdir, 2)
    end
  end

  projects
end

# ── Core logic ────────────────────────────────────────────────────────────────
def should_process?(file_path, config, repo_root, custom_exclude_files)
  file_str = file_path
  filename = File.basename(file_path)

  # Language-specific exclude files
  return false if config["exclude_files"].include?(filename)

  # Custom exclude files from .pcrc
  return false if custom_exclude_files.include?(filename)

  # Automatic dot-folder exclusion
  prefix = repo_root.end_with?("/") ? repo_root : "#{repo_root}/"
  if file_path.start_with?(prefix)
    relative_to_root = file_path.sub(/^#{Regexp.escape(prefix)}/, "")
    components = relative_to_root.split("/")
    dir_components = components[0..-2] || []
    if dir_components.any? { |c| c.start_with?(".") }
      return false
    end
  end

  # Global directory exclusions
  GLOBAL_EXCLUDE_DIRS.each do |d|
    return false if file_str.include?("/#{d}/")
  end

  # Global segment exclusions
  GLOBAL_EXCLUDE_PATH_SEGMENTS.each do |seg|
    return false if file_str.include?(seg)
  end

  true
end

def expected_comment(file_path, repo_root, comment_char)
  repo_root_parent = File.dirname(repo_root)
  prefix = repo_root_parent.end_with?("/") ? repo_root_parent : "#{repo_root_parent}/"
  relative = file_path.sub(/^#{Regexp.escape(prefix)}/, "")
  "#{comment_char} #{relative}"
end

# Is this line a path comment *we* wrote, and therefore ours to rewrite?
#
# Deliberately conservative: the payload must be a lone whitespace-free token
# containing a "/", and must point at either the same basename (the file was
# moved) or the same extension (the file or repo was renamed). Anything with
# prose in it belongs to the author and is left alone — a false positive here
# would delete real source.
def tool_path_comment?(line, comment_char, file_path)
  stripped = line.strip
  return false unless stripped.start_with?("#{comment_char} ")

  payload = stripped[(comment_char.length + 1)..].to_s.strip
  return false if payload.empty? || payload.include?(" ")
  return false unless payload.include?("/")

  return true if File.basename(payload) == File.basename(file_path)

  ext = File.extname(file_path)
  !ext.empty? && File.extname(payload) == ext
end

# Index one past the leading comment/blank block, which is the only region the
# tool ever writes into. Scanning further risks eating a path-shaped comment
# that genuinely belongs to the code below.
def header_block_end(lines, start_at, comment_char)
  idx = start_at
  while idx < lines.length
    stripped = lines[idx].strip
    break unless stripped.empty? || stripped.start_with?(comment_char)
    idx += 1
  end
  idx
end

def strip_path_comments(lines, comment_char, file_path)
  insert_at = lines.first.to_s.start_with?("#!") ? 1 : 0
  block_end = header_block_end(lines, insert_at, comment_char)

  had_comment = false
  kept = lines.each_with_index.reject do |line, idx|
    next false unless idx >= insert_at && idx < block_end
    next false unless tool_path_comment?(line, comment_char, file_path)
    had_comment = true
    true
  end.map(&:first)

  [kept, insert_at, had_comment]
end

def desired_content(file_path, repo_root, comment_char, content)
  lines = content.split("\n", -1)
  kept, insert_at, had_comment = strip_path_comments(lines, comment_char, file_path)
  unless REMOVE
    kept.insert(insert_at, expected_comment(file_path, repo_root, comment_char))
  end
  [kept.join("\n"), had_comment]
end

# Returns true when the file needed a change (whether or not one was written).
def process_file(file_path, repo_root, comment_char, custom_exclude_files)
  content = File.read(file_path, encoding: "utf-8") rescue nil
  return false unless content

  repo_root_parent = File.dirname(repo_root)
  relative = file_path.sub(/^#{Regexp.escape(repo_root_parent + "/")}/, "")

  new_content, had_comment = desired_content(file_path, repo_root, comment_char, content)

  if STDOUT_MODE
    print new_content
    print "\n" unless new_content.end_with?("\n")
    return false
  end

  return false if new_content == content

  verb, gerund = if REMOVE
    ["REMOVED", "remove"]
  elsif had_comment
    ["FIXED", "fix"]
  else
    ["ADDED", "add"]
  end

  if READ_ONLY
    report "[#{DRY_RUN ? "dry-run" : "check"}] Would #{gerund} path comment in #{relative}"
    return true
  end

  File.write(file_path, new_content, encoding: "utf-8")
  report "[#{verb}] #{relative}"
  true
end

# ── Gitignore ─────────────────────────────────────────────────────────────────
# Ask git rather than reimplementing the matching rules — this picks up nested
# .gitignore files, negations and the global excludes file for free. Build
# output (out/, storybook-static/, …) is the case that matters: it is full of
# generated sources the tool would otherwise happily rewrite.
def git_ignored(repo_root, files)
  return [] if files.empty?
  return [] unless File.exist?(File.join(repo_root, ".git"))

  ignored = []
  begin
    IO.popen(["git", "-C", repo_root, "check-ignore", "--stdin"], "r+") do |io|
      io.write(files.join("\n"))
      io.close_write
      ignored = io.read.split("\n")
    end
  rescue StandardError
    # No git binary, or not a usable work tree — fall back to the static excludes.
    return []
  end

  ignored.map { |p| File.expand_path(p, repo_root) }
end

def config_for(file_path)
  basename = File.basename(file_path)
  CONFIGS.each_value do |config|
    return config if config["extensions"].any? { |ext| File.fnmatch(ext, basename) }
  end
  nil
end

# ── Run ───────────────────────────────────────────────────────────────────────
if single_file
  config = config_for(target_dir)
  if config.nil?
    warn "Error: unsupported file type: #{target_path}"
    exit 1
  end
  process_file(target_dir, repo_root, config["comment"], custom_exclude_files)
  exit 0
end

projects = find_projects(repo_root, custom_projects)

if projects.empty?
  warn "No recognisable projects found under #{repo_root}"
  exit 1
end

pending = 0
# A nested marker (e.g. an inner package.json) makes a directory both its own
# project and part of its parent's, so the same file can be reached twice.
seen = {}

projects.each do |project_root, ptype|
  config = CONFIGS[ptype]
  repo_root_parent = File.dirname(repo_root)
  rel = project_root.sub(/^#{Regexp.escape(repo_root_parent + "/")}/, "")
  report "\n── #{rel} (#{ptype}) ──"

  files = []
  config["extensions"].each do |ext|
    glob_pattern = File.join(project_root, "**", ext)
    files.concat(Dir.glob(glob_pattern, File::FNM_DOTMATCH))
  end

  candidates = files.uniq.sort.select do |file_path|
    next false if seen[file_path]
    next false unless File.file?(file_path)
    next false unless should_process?(file_path, config, repo_root, custom_exclude_files)
    seen[file_path] = true
  end

  ignored = git_ignored(repo_root, candidates)
  candidates -= ignored

  candidates.each do |file_path|
    pending += 1 if process_file(file_path, repo_root, config["comment"], custom_exclude_files)
  end
end

if CHECK && pending > 0
  report ""
  if REMOVE
    report "#{pending} file(s) still carry a path comment."
    report "Run add-path-comments --remove to strip them."
  else
    report "#{pending} file(s) have a missing or stale path comment."
    report "Run add-path-comments without --check to fix them."
  end
  exit 1
end
